# Supabase project credentials (Project Settings → API)
# Safe to expose in the browser — RLS enforces access control.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# OneSignal app id (Settings → Keys & IDs). Safe to expose — it ships inside
# every APK regardless, and is useless without the REST API key.
#
# The REST API KEY DOES NOT GO HERE. Vite inlines every VITE_-prefixed variable
# into the bundle, so putting it in this file publishes it. It belongs only in
# the edge function's secrets:  supabase secrets set ONESIGNAL_REST_API_KEY=...
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id

# RevenueCat public SDK key for Android (Project → API keys → Google Play).
# Safe to expose — it is a publishable key and ships inside every APK. The
# SECRET key belongs in the RevenueCat dashboard only and nowhere in this repo.
#
# Unset means the theme store renders every pack as unavailable and the rest of
# the app is untouched: nothing functional sits behind a purchase, so a missing
# store key costs a look and nothing else.
VITE_REVENUECAT_ANDROID_KEY=your-revenuecat-android-key

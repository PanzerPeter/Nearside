# Supabase project credentials (Project Settings → API)
# Safe to expose in the browser — RLS enforces access control.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web Push (VAPID) public key for background message notifications.
# Generate a pair with:  npx web-push generate-vapid-keys
# Put the PUBLIC key here and the PRIVATE key in the send-push Edge Function's
# secrets (VAPID_PRIVATE_KEY). Safe to expose in the browser.
#
# REMOVE THIS when Plan 1 Task 1 Step 4 deletes lib/push.ts and lib/vapid.ts.
# OneSignal replaces the hand-rolled web-push path entirely.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# OneSignal app id (Settings → Keys & IDs). Safe to expose — it ships inside
# every APK regardless, and is useless without the REST API key.
#
# The REST API KEY DOES NOT GO HERE. Vite inlines every VITE_-prefixed variable
# into the bundle, so putting it in this file publishes it. It belongs only in
# the edge function's secrets:  supabase secrets set ONESIGNAL_REST_API_KEY=...
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id

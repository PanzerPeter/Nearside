{
  "name": "nearside",
  "private": true,
  "version": "1.13.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "android:sync": "NEARSIDE_NATIVE=1 vite build && cap sync android",
    "android:open": "cap open android",
    "ios:sync": "NEARSIDE_NATIVE=1 vite build && cap sync ios",
    "ios:open": "cap open ios",
    "electron:sync": "NEARSIDE_NATIVE=1 vite build && cap sync @capawesome/capacitor-electron",
    "electron:install": "cd electron && npm install",
    "electron:start": "npm run electron:sync && cap run @capawesome/capacitor-electron",
    "electron:pack": "npm run electron:sync && cd electron && npm run pack",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "db:verify": "bash supabase/verify/verify.sh",
    "db:audit": "bash supabase/verify/live-audit.sh"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-firebase/crashlytics": "^8.3.0",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource/inter": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.4.0",
    "@scure/bip39": "^2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "emoji-mart": "^5.6.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.43.0",
    "onesignal-cordova-plugin": "^5.5.6",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capawesome/capacitor-electron": "^0.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "daisyui": "^5.7.32",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  }
}

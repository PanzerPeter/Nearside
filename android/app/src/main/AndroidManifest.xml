<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase redirects emailed confirmation and password-reset
                 links here. BROWSABLE is what lets a mail client hand the URL
                 over; without it the tap goes nowhere. MainActivity is
                 singleTask above, so a link tapped while the app is running
                 reaches the existing instance as onNewIntent rather than
                 starting a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.nearside" android:host="auth" />
            </intent-filter>

        </activity>

        <!-- Keeps a call alive once the screen goes off. Without a foreground
             service Android freezes the WebView within seconds of the phone
             being pocketed and the call dies mid-sentence. The type is not
             optional from Android 14: a microphone-using service started
             without declaring one throws and takes the process with it. -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Decline, from the ring notification. Answer is a getActivity
             PendingIntent instead — see CallNotifications for why a receiver
             cannot start one. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Lets a call push become a ring rather than a banner in the shade.
             Resolved by name from OneSignal's own code, so there is no
             reference R8 can see; proguard-rules.pro keeps it. -->
        <meta-data
            android:name="com.onesignal.NotificationServiceExtension"
            android:value="app.nearside.CallNotificationExtension" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Scanning a friend's connect QR. Requested at scan time, never at
         launch: a messenger that asks for the camera on first run reads as a
         red flag to exactly the people this app is for. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Voice messages. getUserMedia inside the WebView reaches Capacitor's
         BridgeWebChromeClient.onPermissionRequest, which launches a runtime
         request for exactly these two. Android refuses to prompt for a
         permission the manifest never declared and returns "denied"
         immediately, which is why recording failed with no dialog and why the
         app had no microphone toggle in its system settings at all. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Haptics on send. A normal permission: granted at install, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Calls.

         The foreground service is what keeps a call alive with the screen off;
         the two typed variants are mandatory from Android 14, where starting a
         microphone service without the matching permission throws.

         USE_FULL_SCREEN_INTENT is the ring taking over the screen. Android 14
         stopped granting it at install to anything Play does not classify as a
         calling app, so declaring it is necessary and not sufficient —
         CallNative.fullScreenIntentAllowed reports what the phone actually
         decided, and Settings offers the grant rather than the app assuming it.

         WAKE_LOCK because a foreground service does not keep the CPU awake on
         its own, and a video call whose peer has muted has stretches with no
         audio path holding one implicitly. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notifications on Android 13+. Requested from the Settings toggle, at
         the moment the user turns them on, and never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Play Billing, for the cosmetic packs. Nothing functional sits behind
         a purchase; see ThemeStore.tsx. -->
    <uses-permission android:name="com.android.vending.BILLING" />
</manifest>

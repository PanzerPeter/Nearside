<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase redirects emailed confirmation and password-reset
                 links here. BROWSABLE is what lets a mail client hand the URL
                 over; without it the tap goes nowhere. MainActivity is
                 singleTask above, so a link tapped while the app is running
                 reaches the existing instance as onNewIntent rather than
                 starting a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.nearside" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Scanning a friend's connect QR. Requested at scan time, never at
         launch: a messenger that asks for the camera on first run reads as a
         red flag to exactly the people this app is for. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Voice messages. getUserMedia inside the WebView reaches Capacitor's
         BridgeWebChromeClient.onPermissionRequest, which launches a runtime
         request for exactly these two. Android refuses to prompt for a
         permission the manifest never declared and returns "denied"
         immediately, which is why recording failed with no dialog and why the
         app had no microphone toggle in its system settings at all. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Haptics on send. A normal permission: granted at install, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notifications on Android 13+. Requested from the Settings toggle, at
         the moment the user turns them on, and never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Play Billing, for the cosmetic packs. Nothing functional sits behind
         a purchase; see ThemeStore.tsx. -->
    <uses-permission android:name="com.android.vending.BILLING" />
</manifest>
